{
  "name": "@hankchen/infra",
  "version": "0.2.2",
  "description": "套件资产初始化 CLI：把本仓库的技能资产安装进目标 git 项目（.agents/skills/ + agent 目录软链 + .infra-lock.json 记账）",
  "type": "module",
  "bin": {
    "infra": "bin/infra.ts"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "agents",
    "scripts"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/prepack.ts",
    "postpack": "node scripts/postpack.ts",
    "prepublishOnly": "node scripts/publish-gate.ts",
    "verify:pack": "node scripts/verify-pack.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "js-yaml": "^5.5.0",
    "typescript": "^5.9.3"
  }
}
